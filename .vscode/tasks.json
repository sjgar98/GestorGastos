{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/GestorGastos.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "crear-env-vacio",
      "type": "process",
      "command": "true",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-Command",
          "if (-not (Test-Path '${workspaceFolder}\\.env')) { New-Item -ItemType File -Path '${workspaceFolder}\\.env' | Out-Null }"
        ]
      },
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "preparar-launch",
      "dependsOrder": "sequence",
      "dependsOn": ["crear-env-vacio", "build"],
      "problemMatcher": []
    }
  ]
}
