@model GestorGastos.DTOs.PaginadoDto<GestorGastos.DTOs.ComprobanteAdminListadoDto>
@using GestorGastos.DTOs
@using GestorGastos.DTOs.Enums
@using GestorGastos.DTOs.Helpers
@using GestorGastos.Web.Helpers
@using Microsoft.Identity.Web

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Todos los comprobantes";
    var filtro = ViewBag.Filtro as FiltroAdminComprobantesDto ?? new FiltroAdminComprobantesDto();
    var empleados = ViewBag.Empleados as IEnumerable<UsuarioDto> ?? new List<UsuarioDto>();
    var adminId = User.GetObjectId();
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Todos los comprobantes</h1>
</div>

<!-- Filtros y orden -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="Estado" class="form-label form-label-sm">Estado</label>
                <select name="Estado" id="Estado" class="form-select form-select-sm">
                    <option value="">Todos los estados</option>
                    @foreach (var estado in Enum.GetValues<EstadoComprobante>())
                    {
                        var valorStr = estado.ToString();
                        <option value="@valorStr" selected="@(filtro.Estado == valorStr)">@estado.Texto()</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="EmpleadoId" class="form-label form-label-sm">Empleado</label>
                <select name="EmpleadoId" id="EmpleadoId" class="form-select form-select-sm">
                    <option value="">Todos los empleados</option>
                    @foreach (var emp in empleados)
                    {
                        <option value="@emp.Id" selected="@(filtro.EmpleadoId == emp.Id)">@emp.Nombre (@emp.Email)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="Orden" class="form-label form-label-sm">Orden</label>
                <select name="Orden" id="Orden" class="form-select form-select-sm">
                    <option value="recientes" selected="@(filtro.Orden == "recientes" || string.IsNullOrEmpty(filtro.Orden))">Más recientes primero</option>
                    <option value="antiguos" selected="@(filtro.Orden == "antiguos")">Más antiguos primero</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-dark btn-sm w-100">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de comprobantes -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Archivo</th>
                        <th>Empleado</th>
                        <th>Fecha de carga</th>
                        <th>Monto</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Elementos == null || !Model.Elementos.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No se encontraron comprobantes con los filtros seleccionados.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var c in Model.Elementos)
                        {
                            var esPropio = c.UsuarioId == adminId;
                            <tr>
                                <td>
                                    <span class="fw-semibold">@c.NombreArchivoOriginal</span>
                                </td>
                                <td>
                                    @c.NombreEmpleado
                                    @if (esPropio)
                                    {
                                        <span class="badge text-bg-secondary ms-1">Propio</span>
                                    }
                                    <br><small class="text-muted">@c.EmailEmpleado</small>
                                </td>
                                <td>@c.FechaCarga.FechaHoraLocal()</td>
                                <td>@c.Monto.Moneda(c.Moneda)</td>
                                <td>
                                    @await Html.PartialAsync("_BadgeEstado", c.Estado)
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Detalle" asp-route-id="@c.Id" class="btn btn-outline-secondary" title="Ver detalle">
                                            <i class="bi bi-eye"></i> Ver detalle
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalRegistros > 0)
    {
        <div class="card-footer d-flex align-items-center justify-content-between flex-wrap py-3">
            <div class="text-muted small mb-2 mb-md-0">
                Mostrando @(((Model.PaginaActual - 1) * Model.TamanoPagina) + 1) al @Math.Min(Model.PaginaActual * Model.TamanoPagina, Model.TotalRegistros) de @Model.TotalRegistros registros
            </div>
            <nav aria-label="Paginación">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PaginaActual - 1)" asp-route-estado="@filtro.Estado" asp-route-empleadoId="@filtro.EmpleadoId" asp-route-orden="@filtro.Orden">Anterior</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(Model.PaginaActual == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-estado="@filtro.Estado" asp-route-empleadoId="@filtro.EmpleadoId" asp-route-orden="@filtro.Orden">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PaginaActual + 1)" asp-route-estado="@filtro.Estado" asp-route-empleadoId="@filtro.EmpleadoId" asp-route-orden="@filtro.Orden">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>