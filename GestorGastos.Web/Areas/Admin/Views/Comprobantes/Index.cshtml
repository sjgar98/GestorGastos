@model PaginadoDto<ComprobanteAdminListadoDto>
@{
    ViewData["Title"] = "Todos los comprobantes";
    var filtro = ViewBag.Filtro as FiltroAdminComprobantesDto ?? new FiltroAdminComprobantesDto();
    var empleados = ViewBag.Empleados as IEnumerable<UsuarioDto> ?? new List<UsuarioDto>();
    var adminId = User.GetObjectId();
    var filtrosDeRuta = new Dictionary<string, string>();
    if (filtro.Estado is not null)
        filtrosDeRuta["estado"] = filtro.Estado.Value.ToString();
    if (!string.IsNullOrEmpty(filtro.EmpleadoId))
        filtrosDeRuta["empleadoId"] = filtro.EmpleadoId;
    if (!string.IsNullOrEmpty(filtro.Orden))
        filtrosDeRuta["orden"] = filtro.Orden;
}

<div class="mb-3">
    <p class="text-body-secondary mb-1">Administración</p>
    <h1 class="h3 mb-0">Todos los comprobantes</h1>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3" data-enviar-al-cambiar>
    <div class="col-sm-6 col-md-4 col-lg-3">
        <label for="Estado" class="form-label small text-body-secondary mb-1">Estado</label>
        <select name="Estado" id="Estado" class="form-select form-select-sm">
            <option value="">Todos</option>
            @foreach (var estado in Enum.GetValues<EstadoComprobante>())
            {
                <option value="@estado" selected="@(filtro.Estado == estado)">@estado.Texto()</option>
            }
        </select>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-3">
        <label for="EmpleadoId" class="form-label small text-body-secondary mb-1">Empleado</label>
        <select name="EmpleadoId" id="EmpleadoId" class="form-select form-select-sm">
            <option value="">Todos</option>
            @foreach (var empleado in empleados)
            {
                <option value="@empleado.Id" selected="@(filtro.EmpleadoId == empleado.Id)">@empleado.Nombre</option>
            }
        </select>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-3">
        <label for="Orden" class="form-label small text-body-secondary mb-1">Orden</label>
        <select name="Orden" id="Orden" class="form-select form-select-sm">
            <option value="recientes" selected="@(filtro.Orden != "antiguos")">Más recientes primero</option>
            <option value="antiguos" selected="@(filtro.Orden == "antiguos")">Más antiguos primero</option>
        </select>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Empleado</th>
                    <th scope="col">Fecha de carga</th>
                    <th scope="col" class="text-end">Monto</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TotalRegistros == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-body-secondary py-5">No hay comprobantes con los filtros elegidos.</td>
                    </tr>
                }
                else
                {
                    foreach (var comprobante in Model.Elementos)
                    {
                        var esPropio = comprobante.UsuarioId == adminId;
                        <tr>
                            <td class="fw-medium text-break">@comprobante.NombreArchivoOriginal</td>
                            <td>
                                @comprobante.NombreEmpleado
                                @if (esPropio)
                                {
                                    <span class="badge text-bg-light border ms-1">Propio</span>
                                }
                            </td>
                            <td>@comprobante.FechaCarga.FechaLocal()</td>
                            <td class="text-end text-nowrap">@comprobante.Monto.Moneda(comprobante.Moneda)</td>
                            <td><partial name="_BadgeEstado" model="comprobante.Estado" /></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    @if (!esPropio)
                                    {
                                        <partial name="_BotonesAccionAdmin" model="new AccionesAdminViewModel { Id = comprobante.Id, Estado = comprobante.Estado, FechaCarga = comprobante.FechaCarga, EnTabla = true }" />
                                    }
                                    <a asp-action="Detalle" asp-route-id="@comprobante.Id" class="btn btn-outline-secondary">Ver detalle</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <partial name="_Paginacion" model="new PaginacionViewModel { Paginado = Model, Filtros = filtrosDeRuta }" />
</div>

<partial name="_ModalesAccionAdmin" />

@section Scripts {
    <script src="~/js/admin-acciones.js" asp-append-version="true"></script>
}
