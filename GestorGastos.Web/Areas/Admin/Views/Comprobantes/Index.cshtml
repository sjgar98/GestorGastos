@model GestorGastos.DTOs.PaginadoDto<GestorGastos.DTOs.ComprobanteAdminListadoDto>
@using GestorGastos.DTOs
@using GestorGastos.Web.Helpers
@using Microsoft.Identity.Web


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Todos los comprobantes";
    var filtro = ViewBag.Filtro as GestorGastos.DTOs.FiltroAdminComprobantesDto ?? new GestorGastos.DTOs.FiltroAdminComprobantesDto();
    var empleados = ViewBag.Empleados as IEnumerable<GestorGastos.DTOs.UsuarioDto> ?? new List<GestorGastos.DTOs.UsuarioDto>();
    var adminId = User.GetObjectId();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Todos los comprobantes</h2>
    </div>

    <!-- Barra de Filtros -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select name="Estado" class="form-select form-select-sm">
                        <option value="">Todos los estados</option>
                        <option value="Procesando" selected="@(filtro.Estado == "Procesando" ? "selected" : null)">Procesando</option>
                        <option value="ErrorExtraccion" selected="@(filtro.Estado == "ErrorExtraccion" ? "selected" : null)">Error de extracción</option>
                        <option value="PendienteRevision" selected="@(filtro.Estado == "PendienteRevision" ? "selected" : null)">Pendiente de Revisión</option>
                        <option value="EnRevision" selected="@(filtro.Estado == "EnRevision" ? "selected" : null)">En Revisión</option>
                        <option value="Aprobado" selected="@(filtro.Estado == "Aprobado" ? "selected" : null)">Aprobado</option>
                        <option value="Rechazado" selected="@(filtro.Estado == "Rechazado" ? "selected" : null)">Rechazado</option>
                        <option value="Pagado" selected="@(filtro.Estado == "Pagado" ? "selected" : null)">Pagado</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Empleado</label>
                    <select name="EmpleadoId" class="form-select form-select-sm">
                        <option value="">Todos los empleados</option>
                        @foreach (var emp in empleados)
                        {
                            <option value="@emp.Id" selected="@(filtro.EmpleadoId == emp.Id ? "selected" : null)">@emp.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Orden</label>
                    <select name="Orden" class="form-select form-select-sm">
                        <option value="recientes" selected="@(filtro.Orden == "recientes" || string.IsNullOrEmpty(filtro.Orden) ? "selected" : null)">Más recientes primero</option>
                        <option value="antiguos" selected="@(filtro.Orden == "antiguos" ? "selected" : null)">Más antiguos primero</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary btn-sm w-100 me-2">Filtrar</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Resultados -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Archivo</th>
                            <th>Empleado</th>
                            <th>Fecha Carga</th>
                            <th>Monto</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Elementos != null && Model.Elementos.Any())
                        {
                            foreach (var item in Model.Elementos)
                            {
                                var esPropio = item.UsuarioId == adminId;
                                <tr>
                                    <td>
                                        <a asp-action="Detalle" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">
                                            @item.NombreArchivoOriginal
                                        </a>
                                    </td>
                                    <td>
                                        @item.NombreEmpleado
                                        @if (esPropio)
                                        {
                                            <span class="badge bg-secondary ms-1" title="Este comprobante es tuyo">Propio</span>
                                        }
                                    </td>
                                    <td>@item.FechaCarga.FechaHoraLocal()</td>
                                    <td>@item.Monto.Moneda(item.Moneda)</td>
                                    <td>
                                        @{
                                            var badgeClass = item.Estado switch
                                            {
                                                "Procesando" => "bg-secondary",
                                                "ErrorExtraccion" => "bg-danger",
                                                "PendienteRevision" => "bg-warning text-dark",
                                                "EnRevision" => "bg-info text-dark",
                                                "Aprobado" => "bg-success",
                                                "Rechazado" => "bg-dark",
                                                "Pagado" => "bg-primary",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@item.Estado</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            @* <a href="/Admin/Comprobantes/Detalle/@item.Id" class="btn btn-sm btn-outline-primary">
                                                Ver detalle
                                            </a> *@
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a href="@Url.Action("Detalle", "Comprobantes", new { area = "Admin", id = item.Id })" class="btn btn-sm btn-outline-primary">
                                                        Ver detalle
                                                    </a>
                                                </div>
                                            </td>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No se encontraron comprobantes con los filtros seleccionados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Paginación (10 elementos por página) -->
    @if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Navegación de páginas" class="mt-4">
            <ul class="pagination pagination-sm justify-content-end">
                <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { pagina = Model.PaginaActual - 1, estado = filtro.Estado, empleadoId = filtro.EmpleadoId, orden = filtro.Orden })">Anterior</a>
                </li>
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(Model.PaginaActual == i ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pagina = i, estado = filtro.Estado, empleadoId = filtro.EmpleadoId, orden = filtro.Orden })">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { pagina = Model.PaginaActual + 1, estado = filtro.Estado, empleadoId = filtro.EmpleadoId, orden = filtro.Orden })">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>