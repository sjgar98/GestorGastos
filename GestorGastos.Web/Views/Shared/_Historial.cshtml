@model List<GestorGastos.DTOs.HistorialEstadoDto>

<div class="card">
    <div class="card-header fw-semibold">Historial</div>
    <ul class="list-group list-group-flush">
        @foreach (var cambio in Model)
        {
            <li class="list-group-item">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div>
                        @if (cambio.EstadoAnterior is not null)
                        {
                            <span class="@cambio.EstadoAnterior.Value.ClaseBadge()">@cambio.EstadoAnterior.Value.Texto()</span>
                            <i class="bi bi-arrow-right mx-1" aria-hidden="true"></i>
                        }
                        <span class="@cambio.EstadoNuevo.ClaseBadge()">@cambio.EstadoNuevo.Texto()</span>
                    </div>
                    <small class="text-body-secondary">@cambio.Fecha.FechaHoraLocal()</small>
                </div>
                <div class="small mt-1">
                    @(cambio.UsuarioNombre ?? "Procesamiento automático")
                    @if (!string.IsNullOrWhiteSpace(cambio.Observacion))
                    {
                        <span class="text-body-secondary">· @cambio.Observacion</span>
                    }
                </div>
            </li>
        }
    </ul>
</div>
