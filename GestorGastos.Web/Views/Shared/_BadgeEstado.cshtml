@using GestorGastos.DTOs
@using GestorGastos.DTOs.Helpers
@model EstadoComprobante

@if (Model == EstadoComprobante.Procesando)
{
    <span class="@Model.ClaseBadge()">
        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
        @Model.Texto()
    </span>
}
else
{
    <span class="@Model.ClaseBadge()">@Model.Texto()</span>
}
