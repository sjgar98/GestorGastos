@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center my-5">
    <div class="col-md-8 col-lg-6">
        <div class="card border-danger-subtle">
            <div class="card-body text-center">
                <h1 class="h4 text-danger">Ocurrió un error inesperado</h1>
                <p class="text-body-secondary mb-0">Intentá de nuevo en unos minutos.</p>
                @if (Model.MostrarRequestId)
                {
                    <p class="small text-body-secondary mt-3 mb-0">Código de seguimiento: <code>@Model.RequestId</code></p>
                }
            </div>
        </div>
    </div>
</div>
