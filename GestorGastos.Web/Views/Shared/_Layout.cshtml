<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Reembolsos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    @Html.AntiForgeryToken()
    @if (User.Identity?.IsAuthenticated == true)
    {
        var areaActual = ViewContext.RouteData.Values["area"]?.ToString();
        var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
        var accionActual = ViewContext.RouteData.Values["action"]?.ToString();
        var enAdministracion = areaActual == "Admin";
        var enDashboard = !enAdministracion && controladorActual == "Home" && accionActual == "Index";
        var enComprobantes = !enAdministracion && controladorActual == "Comprobantes";
        var enCargar = enComprobantes && accionActual is "Cargar" or "Resultado" or "Editar";
        var enMisComprobantes = enComprobantes && !enCargar;
        <nav class="navbar navbar-expand-md bg-body border-bottom">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">Reembolsos</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navPrincipal" aria-controls="navPrincipal" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navPrincipal">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        @if (User.TieneRol())
                        {
                            <li class="nav-item">
                                <a class="nav-link @(enDashboard ? "active" : "")" aria-current="@(enDashboard ? "page" : null)" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(enMisComprobantes ? "active" : "")" aria-current="@(enMisComprobantes ? "page" : null)" href="/Comprobantes">Mis comprobantes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(enCargar ? "active" : "")" aria-current="@(enCargar ? "page" : null)" asp-area="" asp-controller="Comprobantes" asp-action="Cargar">Cargar</a>
                            </li>
                            @if (User.IsInRole(Roles.Administrador))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(enAdministracion ? "active" : "")" aria-current="@(enAdministracion ? "page" : null)" asp-area="Admin" asp-controller="Comprobantes" asp-action="Index">Administración</a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @User.Nombre()
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">@User.Rol()</h6></li>
                            <li><span class="dropdown-item-text small text-body-secondary">@User.Email()</span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="" asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                                    <button type="submit" class="dropdown-item">Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    }
    <div class="container">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
