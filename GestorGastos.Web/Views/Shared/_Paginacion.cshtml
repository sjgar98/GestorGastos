@model PaginacionViewModel
@{
    var paginado = Model.Paginado;
}

<div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
    <span class="small text-body-secondary">
        @if (paginado.TotalRegistros == 0)
        {
            <text>Sin resultados</text>
        }
        else
        {
            <text>Mostrando @paginado.Desde–@paginado.Hasta de @paginado.TotalRegistros</text>
        }
    </span>
    @if (paginado.TotalPaginas > 0)
    {
        <nav aria-label="Paginación">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(paginado.PaginaActual <= 1 ? "disabled" : string.Empty)">
                    @if (paginado.PaginaActual <= 1)
                    {
                        <span class="page-link">Anterior</span>
                    }
                    else
                    {
                        <a class="page-link" asp-action="Index" asp-all-route-data="Model.Filtros" asp-route-pagina="@(paginado.PaginaActual - 1)">Anterior</a>
                    }
                </li>
                @for (var numeroPagina = 1; numeroPagina <= paginado.TotalPaginas; numeroPagina++)
                {
                    <li class="page-item @(paginado.PaginaActual == numeroPagina ? "active" : string.Empty)">
                        @if (paginado.PaginaActual == numeroPagina)
                        {
                            <span class="page-link" aria-current="page">@numeroPagina</span>
                        }
                        else
                        {
                            <a class="page-link" asp-action="Index" asp-all-route-data="Model.Filtros" asp-route-pagina="@numeroPagina">@numeroPagina</a>
                        }
                    </li>
                }
                <li class="page-item @(paginado.PaginaActual >= paginado.TotalPaginas ? "disabled" : string.Empty)">
                    @if (paginado.PaginaActual >= paginado.TotalPaginas)
                    {
                        <span class="page-link">Siguiente</span>
                    }
                    else
                    {
                        <a class="page-link" asp-action="Index" asp-all-route-data="Model.Filtros" asp-route-pagina="@(paginado.PaginaActual + 1)">Siguiente</a>
                    }
                </li>
            </ul>
        </nav>
    }
</div>
