@model PaginadoDto<ComprobanteListadoDto>
@{
    ViewData["Title"] = "Mis comprobantes";
    var filtro = ViewBag.Filtro as FiltroMisComprobantesDto ?? new FiltroMisComprobantesDto();
    var filtrosDeRuta = new Dictionary<string, string>();
    if (filtro.Estado is not null)
        filtrosDeRuta["estado"] = filtro.Estado.Value.ToString();
    if (!string.IsNullOrEmpty(filtro.Orden))
        filtrosDeRuta["orden"] = filtro.Orden;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <p class="text-body-secondary mb-1">Comprobantes</p>
        <h1 class="h3 mb-0">Mis comprobantes</h1>
    </div>
    <a asp-action="Cargar" class="btn btn-primary">Cargar comprobante</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3" data-enviar-al-cambiar>
    <div class="col-sm-6 col-md-4 col-lg-3">
        <label for="Estado" class="form-label small text-body-secondary mb-1">Estado</label>
        <select name="Estado" id="Estado" class="form-select form-select-sm">
            <option value="">Todos</option>
            @foreach (var estado in Enum.GetValues<EstadoComprobante>())
            {
                <option value="@estado" selected="@(filtro.Estado == estado)">@estado.Texto()</option>
            }
        </select>
    </div>
    <div class="col-sm-6 col-md-4 col-lg-3">
        <label for="Orden" class="form-label small text-body-secondary mb-1">Orden</label>
        <select name="Orden" id="Orden" class="form-select form-select-sm">
            <option value="recientes" selected="@(filtro.Orden != "antiguos")">Más recientes primero</option>
            <option value="antiguos" selected="@(filtro.Orden == "antiguos")">Más antiguos primero</option>
        </select>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Fecha de carga</th>
                    <th scope="col" class="text-end">Monto</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-end">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TotalRegistros == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-body-secondary py-5">
                            @(filtro.Estado is null ? "No hay comprobantes cargados." : "No hay comprobantes con este estado.")
                            <a asp-action="Cargar">Cargar comprobante</a>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var comprobante in Model.Elementos)
                    {
                        var procesando = comprobante.Estado == EstadoComprobante.Procesando;
                        var sePuedeEliminar = comprobante.Estado is EstadoComprobante.PendienteRevision or EstadoComprobante.ErrorExtraccion;
                        <tr data-id="@comprobante.Id" data-procesando="@(procesando ? "true" : null)">
                            <td class="fw-medium text-break">@comprobante.NombreArchivoOriginal</td>
                            <td>@comprobante.FechaCarga.FechaLocal()</td>
                            <td class="text-end text-nowrap" data-celda="monto">@comprobante.Monto.Moneda(comprobante.Moneda)</td>
                            <td data-celda="estado"><partial name="_BadgeEstado" model="comprobante.Estado" /></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Detalle" asp-route-id="@comprobante.Id" class="btn btn-outline-secondary">Ver detalle</a>
                                    @if (sePuedeEliminar || procesando)
                                    {
                                        <button type="button" class="btn btn-outline-danger" hidden="@procesando"
                                                data-bs-toggle="modal" data-bs-target="#modal-eliminar"
                                                data-id="@comprobante.Id" data-nombre="@comprobante.NombreArchivoOriginal">Eliminar</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <partial name="_Paginacion" model="new PaginacionViewModel { Paginado = Model, Filtros = filtrosDeRuta }" />
</div>

@if (Model.Elementos.Count > 0)
{
    <partial name="_ModalEliminar" model="string.Empty" />
}

@section Scripts {
    <script src="~/js/mis-comprobantes.js" asp-append-version="true"></script>
}
