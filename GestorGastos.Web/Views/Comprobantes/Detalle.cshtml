@using System.Globalization
@using GestorGastos.DTOs.Enums
@model GestorGastos.DTOs.ComprobanteDetalleDto
@{
    ViewData["Title"] = Model.NombreArchivoOriginal;
    var puedeModificar = Model.Estado == EstadoComprobante.PendienteRevision
        || Model.Estado == EstadoComprobante.ErrorExtraccion;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Comprobantes">Mis comprobantes</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.NombreArchivoOriginal</li>
    </ol>
</nav>

<h1 class="h2 mb-4">
    @Model.NombreArchivoOriginal
    <span class="@Model.Estado.ClaseBadge() fs-6 align-middle">@Model.Estado.Texto()</span>
</h1>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Vista previa</span>
                <button type="button" id="boton-descargar" class="btn btn-sm btn-outline-secondary" disabled>Descargar</button>
            </div>
            <div id="vista-previa"
                 class="vista-previa bg-body-secondary d-flex align-items-center justify-content-center text-muted"
                 data-comprobante-id="@Model.Id"
                 data-content-type="@Model.ContentType">
                La vista previa todavía no está disponible.
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header fw-semibold">Datos del comprobante</div>
            <div class="card-body">
                @if (Model.Estado == EstadoComprobante.Procesando)
                {
                    <div class="alert alert-secondary">Estamos analizando el comprobante. Los datos van a aparecer en unos instantes.</div>
                }
                @if (Model.Estado == EstadoComprobante.ErrorExtraccion)
                {
                    <div class="alert alert-warning">
                        <strong>No pudimos leer el comprobante.</strong>
                        @Model.MensajeError
                        Completá descripción y monto para enviarlo a revisión.
                    </div>
                }
                @if (Model.Estado == EstadoComprobante.Rechazado)
                {
                    <div class="alert alert-danger">
                        <strong>Motivo del rechazo:</strong> @Model.MotivoRechazo
                    </div>
                }

                <dl class="row mb-0">
                    <dt class="col-sm-5 fw-normal text-muted">Archivo</dt>
                    <dd class="col-sm-7">@Model.NombreArchivoOriginal</dd>

                    <dt class="col-sm-5 fw-normal text-muted">Tipo</dt>
                    <dd class="col-sm-7">@Model.TipoDocumento.Texto()</dd>

                    <dt class="col-sm-5 fw-normal text-muted">Categoría</dt>
                    <dd class="col-sm-7">@Model.Categoria.Texto()</dd>

                    <dt class="col-sm-5 fw-normal text-muted">Comercio</dt>
                    <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(Model.Comercio) ? "—" : Model.Comercio)</dd>

                    <dt class="col-sm-5 fw-normal text-muted">Fecha del comprobante</dt>
                    <dd class="col-sm-7">@(Model.FechaComprobante?.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) ?? "—")</dd>

                    <dt class="col-sm-5 fw-normal text-muted">Descripción</dt>
                    <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "—" : Model.Descripcion)</dd>

                    <dt class="col-sm-5 fw-normal text-muted">Monto</dt>
                    <dd class="col-sm-7 fw-bold">@Model.Monto.Moneda(Model.Moneda?.ToString())</dd>

                    <dt class="col-sm-5 fw-normal text-muted">Fecha de carga</dt>
                    <dd class="col-sm-7">@Model.FechaCarga.ConvertirAArgentina().ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)</dd>

                    @if (Model.FechaPago != null)
                    {
                        <dt class="col-sm-5 fw-normal text-muted">Fecha de pago</dt>
                        <dd class="col-sm-7">@Model.FechaPago.Value.ConvertirAArgentina().ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)</dd>
                    }

                    @if (Model.EditadoManualmente)
                    {
                        <dt class="col-sm-5 fw-normal text-muted">Edición</dt>
                        <dd class="col-sm-7"><span class="badge text-bg-light border">Editados manualmente</span></dd>
                    }
                </dl>
            </div>

            @if (puedeModificar)
            {
                <div class="card-footer">
                    <button type="button" id="boton-editar" class="btn btn-primary">Editar datos</button>
                    <button type="button" id="boton-eliminar" class="btn btn-outline-danger"
                            data-bs-toggle="modal" data-bs-target="#modal-eliminar">
                        Eliminar
                    </button>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header fw-semibold">Historial</div>
            <ul class="list-group list-group-flush">
                @foreach (var cambio in Model.Historial)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                @if (cambio.EstadoAnterior != null)
                                {
                                    <span class="@cambio.EstadoAnterior.Value.ClaseBadge()">@cambio.EstadoAnterior.Value.Texto()</span>
                                    <i class="bi bi-arrow-right mx-1"></i>
                                }
                                <span class="@cambio.EstadoNuevo.ClaseBadge()">@cambio.EstadoNuevo.Texto()</span>
                            </div>
                            <small class="text-muted">@cambio.Fecha.ConvertirAArgentina().ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)</small>
                        </div>
                        <div class="small mt-1">
                            @(cambio.UsuarioNombre ?? "Procesamiento automático")
                            @if (!string.IsNullOrWhiteSpace(cambio.Observacion))
                            {
                                <span class="text-muted">· @cambio.Observacion</span>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
    @if (puedeModificar)
    {
        <div class="modal fade" id="modal-eliminar" tabindex="-1" aria-labelledby="titulo-modal-eliminar" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="titulo-modal-eliminar">Eliminar comprobante</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div id="error-eliminar" class="alert alert-danger d-none" role="alert"></div>
                        <p class="mb-0">Se va a eliminar <strong>@Model.NombreArchivoOriginal</strong> y su archivo. Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" id="confirmar-eliminar" class="btn btn-danger">Eliminar</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
@section Scripts {
    <script src="~/js/detalle.js" asp-append-version="true"></script>
}