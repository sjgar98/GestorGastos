@model DetalleComprobanteViewModel
@{
    var c = Model.Comprobante;
    ViewData["Title"] = c.NombreArchivoOriginal;
    var puedeModificar = c.Estado is EstadoComprobante.PendienteRevision or EstadoComprobante.ErrorExtraccion;
    var estaEnError = c.Estado == EstadoComprobante.ErrorExtraccion;
    var mostrarFormulario = estaEnError || !ViewData.ModelState.IsValid;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Mis comprobantes</a></li>
        <li class="breadcrumb-item active" aria-current="page">@c.NombreArchivoOriginal</li>
    </ol>
</nav>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <h1 class="h2 mb-0 text-break">@c.NombreArchivoOriginal</h1>
    <partial name="_BadgeEstado" model="c.Estado" />
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <partial name="_VistaPrevia" model="(c.Id, c.ContentType)" />
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header fw-semibold">Datos del comprobante</div>
            <div class="card-body">
                @if (c.Estado == EstadoComprobante.Procesando)
                {
                    <div class="alert alert-secondary">Estamos analizando el comprobante. Los datos van a aparecer en unos instantes.</div>
                }
                @if (estaEnError)
                {
                    <div class="alert alert-warning">
                        <strong>No pudimos leer el comprobante.</strong>
                        @c.MensajeError
                        Completá descripción y monto para enviarlo a revisión.
                    </div>
                }
                @if (c.Estado == EstadoComprobante.Rechazado)
                {
                    <div class="alert alert-danger">
                        <strong>Motivo del rechazo:</strong> @c.MotivoRechazo
                    </div>
                }

                <dl class="row mb-0">
                    <dt class="col-sm-5 fw-normal text-body-secondary">Archivo</dt>
                    <dd class="col-sm-7 text-break">@c.NombreArchivoOriginal</dd>

                    <dt class="col-sm-5 fw-normal text-body-secondary">Tipo</dt>
                    <dd class="col-sm-7">@c.TipoDocumento.Texto()</dd>

                    <dt class="col-sm-5 fw-normal text-body-secondary">Categoría</dt>
                    <dd class="col-sm-7">@c.Categoria.Texto()</dd>

                    <dt class="col-sm-5 fw-normal text-body-secondary">Comercio</dt>
                    <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(c.Comercio) ? "—" : c.Comercio)</dd>

                    <dt class="col-sm-5 fw-normal text-body-secondary">Fecha del comprobante</dt>
                    <dd class="col-sm-7">@c.FechaComprobante.FechaLocal()</dd>

                    <dt class="col-sm-5 fw-normal text-body-secondary">Descripción</dt>
                    <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(c.Descripcion) ? "—" : c.Descripcion)</dd>

                    <dt class="col-sm-5 fw-normal text-body-secondary">Monto</dt>
                    <dd class="col-sm-7 fw-bold">@c.Monto.Moneda(c.Moneda)</dd>

                    <dt class="col-sm-5 fw-normal text-body-secondary">Fecha de carga</dt>
                    <dd class="col-sm-7">@c.FechaCarga.FechaHoraLocal()</dd>

                    @if (c.FechaPago is not null)
                    {
                        <dt class="col-sm-5 fw-normal text-body-secondary">Fecha de pago</dt>
                        <dd class="col-sm-7">@c.FechaPago.Value.FechaLocal()</dd>
                    }

                    @if (c.EditadoManualmente)
                    {
                        <dt class="col-sm-5 fw-normal text-body-secondary">Edición</dt>
                        <dd class="col-sm-7"><span class="badge text-bg-light border">Editados manualmente</span></dd>
                    }
                </dl>
            </div>

            @if (puedeModificar)
            {
                <div class="card-footer d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#formulario-edicion"
                            aria-expanded="@(mostrarFormulario ? "true" : "false")" aria-controls="formulario-edicion">
                        Editar datos
                    </button>
                    <button type="button" class="btn btn-outline-danger"
                            data-bs-toggle="modal" data-bs-target="#modal-eliminar"
                            data-id="@c.Id" data-nombre="@c.NombreArchivoOriginal">
                        Eliminar
                    </button>
                </div>

                <div class="collapse @(mostrarFormulario ? "show" : string.Empty)" id="formulario-edicion">
                    <form asp-action="EditarDetalle" asp-route-id="@c.Id" method="post" class="card-body border-top" novalidate>
                        <partial name="_FormularioEdicion" model="new FormularioEdicionViewModel { Formulario = Model.Formulario }" />

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#formulario-edicion">Cancelar</button>
                            <button type="submit" class="btn btn-primary">@(estaEnError ? "Guardar y enviar a revisión" : "Guardar cambios")</button>
                        </div>
                    </form>
                </div>
            }
        </div>

        <partial name="_Historial" model="c.Historial" />
    </div>
</div>

@if (puedeModificar)
{
    <partial name="_ModalEliminar" model="@Url.Action("Index")" />
}

@section Scripts {
    @if (puedeModificar)
    {
        <partial name="_ValidationScriptsPartial" />
        <script src="~/js/validacion-bootstrap.js" asp-append-version="true"></script>
    }
}
