# Copiar a .env (ignorado por git). Solo necesario en Linux/macOS, donde no existe LocalDB.
# Si GESTORGASTOS_DB_HOST no está definida se usa LocalDB. PORT y NAME son opcionales (1433 y GestorGastos).
# compose.yaml usa PORT y PASSWORD para levantar el contenedor de SQL Server.
GESTORGASTOS_DB_HOST=localhost
GESTORGASTOS_DB_PORT=1433
GESTORGASTOS_DB_NAME=GestorGastos
GESTORGASTOS_DB_USER=sa
GESTORGASTOS_DB_PASSWORD=<password>
